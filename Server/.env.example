# Database Connection String
DB_CONNECTION_STRING=Host=localhost;Database=mmorpg;Username=postgres;Password=mypassword

# Network
SERVER_PORT=7777

# Version Control
GAME_VERSION=0.2.2-alpha

# Account Limitations
DEFAULT_CHARACTER_SLOT=3

# Persistence (write-behind): changes are saved in the background, in per-character order
WRITE_BEHIND_FLUSH_SECONDS=2
AUTOSAVE_SECONDS=60
PERSISTENCE_WORKERS=4
PERSISTENCE_MAX_ATTEMPTS=8
CHAT_LOG_QUEUE_SIZE=10000

# Vitals Regeneration
BASE_HEALTH_RES=5
BASE_MANA_RES=3
REGEN_TICK_INTERVAL_SECONDS=1
REGEN_COOLDOWN_SECONDS=5
MAX_PENDING_COMMANDS_PER_CLIENT=128
COMMAND_BUDGET_MS=10

# Network I/O limits (timeouts in seconds, 0 disables the two read timeouts)
MAX_INBOUND_PACKET_BYTES=4096
PACKET_COMPLETION_TIMEOUT_SECONDS=10
PRE_AUTH_IDLE_TIMEOUT_SECONDS=30
SEND_TIMEOUT_SECONDS=5

# Abuse protection: an address that fails SIGNIN_MAX_FAILURES sign-in/sign-up attempts within the window is locked
# out for SIGNIN_LOCKOUT_SECONDS; chat allows a burst of CHAT_BURST messages, then CHAT_MESSAGES_PER_SECOND
SIGNIN_MAX_FAILURES=5
SIGNIN_FAILURE_WINDOW_SECONDS=60
SIGNIN_LOCKOUT_SECONDS=60
CHAT_BURST=5
CHAT_MESSAGES_PER_SECOND=1

# Combat logging: disconnecting within COMBAT_TAG_SECONDS of a fight leaves the character in the world,
# defenseless, for COMBAT_LOGOUT_LINGER_SECONDS (0 disables either)
COMBAT_TAG_SECONDS=10
COMBAT_LOGOUT_LINGER_SECONDS=15

# A client that selected a character must load the map and send WorldReadyRequest within this many seconds,
# or it is disconnected (0 disables). Until then the character is invisible and cannot act.
WORLD_READY_TIMEOUT_SECONDS=60

# RPG Progression & Leveling
EXP_BASE=100
EXP_GROWTH_RATE=1.5
STAT_POINTS_PER_LEVEL=5

# Inventory Configuration
DEFAULT_BACKPACK_SLOTS=20

# World Loot Satchels
LOOT_OWNERSHIP_SECONDS=30
LOOT_DECAY_SECONDS=120

# Chat Logging Configuration
CHAT_LOG_LOCAL=false
CHAT_LOG_GLOBAL=true
CHAT_LOG_WHISPER=true
CHAT_LOG_SYSTEM=false
